# Copy to .env and fill in. Keep .env out of git (see .gitignore).
# Real environment variables always override this file.

# fixture = hand-written stand-ins (no model), gemini, anthropic, replay = re-run a recorded reply
MINEGEN_BACKEND=gemini
# Model id for the chosen backend. Left empty, the backend default is used (gemini-2.5-flash / claude-sonnet-5-5).
MINEGEN_MODEL=gemini-3.5-flash-lite
# One key variable that works for whichever backend is selected...
MINEGEN_API_KEY=
# ...or the provider's own variable:
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Paths used by `check` and `mutate`, so you do not retype them
HYPERON_MINER_DIR=../hyperon-miner
PETTA_RUN=../PeTTa/run.sh
# MINEGEN_CACHE=.minegen_cache
